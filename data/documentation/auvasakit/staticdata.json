ent":[{"text":"Find stops matching a query:","type":"text"}]},{"type":"codeListing","code":["let stops = try await client.searchStops(query: \"plaza\")","","for stop in stops {","    print(\"\\(stop.name) (\\(stop.code ?? \"?\"))\")","}"],"syntax":"swift"},{"type":"heading","anchor":"Find-Nearby-Stops","level":3,"text":"Find Nearby Stops"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for stops within a radius:"}]},{"type":"codeListing","code":["let userLocation = Coordinate(latitude: 41.6523, longitude: -4.7245)","let nearbyStops = try await client.findNearbyStops(","    coordinate: userLocation,","    radiusMeters: 500",")","","for stop in nearbyStops {","    let distance = userLocation.distance(to: stop.coordinate)","    print(\"\\(stop.name): \\(Int(distance))m away\")","}"],"syntax":"swift"},{"anchor":"Get-All-Stops","type":"heading","level":3,"text":"Get All Stops"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch the complete stop database:"}]},{"syntax":"swift","type":"codeListing","code":["let allStops = try await client.fetchAllStops()","print(\"Total stops: \\(allStops.count)\")"]},{"anchor":"Filter-Wheelchair-Accessible-Stops","type":"heading","level":3,"text":"Filter Wheelchair Accessible Stops"},{"type":"paragraph","inlineContent":[{"text":"Find stops with wheelchair boarding:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let accessibleStops = try await client.fetchWheelchairAccessibleStops()","","for stop in accessibleStops {","    print(\"♿️ \\(stop.name)\")","}"]},{"anchor":"Working-with-Routes","type":"heading","level":2,"text":"Working with Routes"},{"anchor":"Get-All-Routes","type":"heading","level":3,"text":"Get All Routes"},{"type":"paragraph","inlineContent":[{"text":"Fetch all bus lines:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let routes = try await client.fetchRoutes()","","for route in routes {","    print(\"\\(route.shortName): \\(route.longName)\")","    i