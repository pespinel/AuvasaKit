  let color: String?     \/\/ Hex color","    \/\/ ... more properties","}"]},{"anchor":"StopTime","type":"heading","level":3,"text":"StopTime"},{"syntax":"swift","type":"codeListing","code":["public struct StopTime {","    let tripId: String","    let stopId: String","    let arrivalTime: String      \/\/ \"14:30:00\"","    let departureTime: String    \/\/ \"14:30:00\"","    let stopSequence: Int        \/\/ Order in trip","    \/\/ ... more properties","}"]},{"anchor":"Trip","type":"heading","level":3,"text":"Trip"},{"syntax":"swift","type":"codeListing","code":["public struct Trip {","    let id: String","    let routeId: String","    let serviceId: String","    let headsign: String?         \/\/ Destination","    let directionId: Int?         \/\/ 0 or 1","    let wheelchairAccessible: WheelchairAccessibility","    \/\/ ... more properties","}"]},{"anchor":"Performance-Tips","type":"heading","level":2,"text":"Performance Tips"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Use Nearby Search"}],"type":"strong"},{"type":"text","text":": When searching geographically, use "},{"code":"findNearbyStops()","type":"codeVoice"},{"type":"text","text":" instead of fetching all stops and filtering manually"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Limit Results","type":"text"}],"type":"strong"},{"type":"text","text":": Use the "},{"code":"limit","type":"codeVoice"},{"type":"text","text":" parameter to reduce data transfer:"}]},{"syntax":"swift","type":"codeListing","code":["let stops = try await client.fetchUpcomingDepartures(stopId: \"123\", limit: 5)"]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cache Results","type":"text"}],"type":"strong"},{"type":"text","text":": Static data rarely changes, so cache results in your app if you access them frequently"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong",