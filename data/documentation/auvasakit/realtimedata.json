{"kind":"article","hierarchy":{"paths":[["doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Real-Time Data","modules":[{"name":"AuvasaKit"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"Access live transit information from AUVASA’s GTFS Real-Time feed."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"AuvasaKit provides three types of real-time data:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vehicle Positions","type":"text"}]},{"type":"text","text":" - GPS locations of active buses"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Trip Updates","type":"text"}]},{"type":"text","text":" - Predicted arrival times with delays"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Service Alerts","type":"text"}],"type":"strong"},{"type":"text","text":" - Disruptions and notifications"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"All real-time data is updated every 15-30 seconds from AUVASA’s servers.","type":"text"}]},{"type":"heading","text":"Vehicle Positions","anchor":"Vehicle-Positions","level":2},{"type":"heading","text":"Fetch All Vehicles","anchor":"Fetch-All-Vehicles","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get positions of all active buses:"}]},{"type":"codeListing","syntax":"swift","code":["let vehicles = try await client.fetchVehiclePositions()","","for vehicle in vehicles {","    print(\"Vehicle: \\(vehicle.vehicle.label ?? vehicle.vehicle.id)\")","    print(\"  Position: \\(vehicle.position.latitude), \\(vehicle.position.longitude)\")","    print(\"  Bearing: \\(vehicle.bearing ?? 0)°\")","    print(\"  Speed: \\(vehicle.speed ?? 0) m\/s\")","","    if let occupancy = vehicle.occupancyStatus {","        print(\"  Occupancy: \\(occupancy)\")","    }","","    if let trip = vehicle.trip {","        print(\"  Route: \\(trip.routeId)\")","        print(\"  Destination: \\(trip.tripHeadsign ?? \"?\")\")","    }","}"]},{"type":"heading","text":"Filter by Route","anchor":"Filter-by-Route","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get vehicles only on a specific route:"}]},{"type":"codeListing","syntax":"swift","code":["let line1Buses = try await client.fetchVehiclePositions(routeId: \"L1\")"]},{"type":"heading","text":"Find Nearby Vehicles","anchor":"Find-Nearby-Vehicles","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for buses within a radius:"}]},{"type":"codeListing","syntax":"swift","code":["let userLocation = Coordinate(latitude: 41.6523, longitude: -4.7245)","let nearbyBuses = try await client.findNearbyVehicles(","    coordinate: userLocation,","    radiusMeters: 1000  \/\/ 1 km radius",")","","for vehicle in nearbyBuses {","    let distance = userLocation.distance(to: vehicle.position)","    print(\"\\(vehicle.vehicle.label ?? \"?\"): \\(Int(distance))m away\")","}"]},{"type":"heading","text":"Trip Updates","anchor":"Trip-Updates","level":2},{"type":"heading","text":"Get Arrivals at a Stop","anchor":"Get-Arrivals-at-a-Stop","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch predicted arrivals with real-time delays:"}]},{"type":"codeListing","syntax":"swift","code":["let updates = try await client.fetchTripUpdates(stopId: \"123\")","","for update in updates {","    print(\"Trip: \\(update.trip.tripId)\")","","    if let delay = update.delay {","        print(\"  Overall delay: \\(delay) seconds\")","    }","","    for stopUpdate in update.stopTimeUpdates {","        if stopUpdate.stopId == \"123\" {","            if let arrival = stopUpdate.arrival {","                print(\"  Arrival: \\(Date(timeIntervalSince1970: TimeInterval(arrival.time)))\")","                if let delay = arrival.delay {","                    print(\"  Delay: \\(delay) seconds\")","                }","            }","        }","    }","}"]},{"type":"heading","text":"Combined Arrivals (Recommended)","anchor":"Combined-Arrivals-Recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"getNextArrivals()","type":"codeVoice"},{"type":"text","text":" for a simplified API that merges schedule + real-time:"}]},{"type":"codeListing","syntax":"swift","code":["let arrivals = try await client.getNextArrivals(stopId: \"123\", limit: 5)","","for arrival in arrivals {","    print(\"\\(arrival.route.shortName): \\(arrival.trip.headsign ?? \"?\")\")","    print(\"  Best time: \\(arrival.bestTime)\")  \/\/ Uses estimated or scheduled","","    if arrival.realtimeAvailable {","        if let delay = arrival.delayDescription {","            print(\"  Status: \\(delay)\")  \/\/ \"5 min late\", \"On time\", etc.","        }","    } else {","        print(\"  Status: Scheduled (no real-time data)\")","    }","","    if arrival.isDelayed {","        print(\"  ⚠️ Delayed > 5 minutes\")","    }","}"]},{"type":"heading","text":"Service Alerts","anchor":"Service-Alerts","level":2},{"type":"heading","text":"Fetch All Alerts","anchor":"Fetch-All-Alerts","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get current service disruptions:"}]},{"type":"codeListing","syntax":"swift","code":["let alerts = try await client.fetchAlerts()","","for alert in alerts {","    print(\"Alert: \\(alert.headerText)\")","    print(\"  \\(alert.descriptionText)\")","    print(\"  Severity: \\(alert.severity)\")","","    if let cause = alert.cause {","        print(\"  Cause: \\(cause)\")","    }","    if let effect = alert.effect {","        print(\"  Effect: \\(effect)\")","    }","","    print(\"  Active periods:\")","    for period in alert.activePeriods {","        print(\"    \\(period.start) - \\(period.end ?? \"ongoing\")\")","    }","}"]},{"type":"heading","text":"Filter by Route","anchor":"Filter-by-Route","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get alerts affecting a specific route:"}]},{"type":"codeListing","syntax":"swift","code":["let route1Alerts = try await client.fetchAlerts(routeId: \"L1\")"]},{"type":"heading","text":"Trip Details","anchor":"Trip-Details","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get comprehensive information about a specific trip:"}]},{"type":"codeListing","syntax":"swift","code":["let tripDetails = try await client.getTripDetails(tripId: \"TRIP_123\")","","print(\"Route: \\(tripDetails.route.longName)\")","print(\"Destination: \\(tripDetails.trip.headsign ?? \"?\")\")","print(\"Stops: \\(tripDetails.stopCount)\")","","if let delay = tripDetails.delay {","    print(\"Current delay: \\(delay) seconds\")","}","","if let progress = tripDetails.progress {","    print(\"Progress: \\(Int(progress * 100))%\")","}","","if let nextStop = tripDetails.nextStop {","    print(\"Next stop: \\(nextStop.stopId)\")","    print(\"  Arrival: \\(nextStop.bestTime)\")","}","","if let currentStop = tripDetails.currentStop {","    print(\"Current stop: \\(currentStop.stopId)\")","}"]},{"type":"heading","text":"Data Freshness","anchor":"Data-Freshness","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Real-time data typically updates every 15-30 seconds. The "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" field on each entity indicates when the data was last updated:"}]},{"type":"codeListing","syntax":"swift","code":["let vehicles = try await client.fetchVehiclePositions()","","for vehicle in vehicles {","    let age = Date().timeIntervalSince(vehicle.timestamp)","    print(\"Data age: \\(Int(age)) seconds\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For continuous updates, use "},{"type":"reference","identifier":"doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit\/Subscriptions","isActive":true},{"type":"text","text":" instead of polling manually."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit\/RealTimeData"},"seeAlsoSections":[{"anchor":"Real-Time-Features","identifiers":["doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit\/Subscriptions"],"generated":true,"title":"Real-Time Features"}],"variants":[{"paths":["\/documentation\/auvasakit\/realtimedata"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://auvasakit.AuvasaKit/documentation/AuvasaKit/Subscriptions":{"kind":"article","abstract":[{"text":"Subscribe to continuous real-time updates using AsyncStream.","type":"text"}],"url":"\/documentation\/auvasakit\/subscriptions","identifier":"doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit\/Subscriptions","role":"article","type":"topic","title":"Subscriptions"},"doc://auvasakit.AuvasaKit/documentation/AuvasaKit":{"url":"\/documentation\/auvasakit","role":"collection","type":"topic","title":"AuvasaKit","identifier":"doc:\/\/auvasakit.AuvasaKit\/documentation\/AuvasaKit","abstract":[{"text":"Modern Swift SDK for accessing AUVASA (Autobuses Urbanos de Valladolid) transit data.","type":"text"}],"kind":"symbol"}}}